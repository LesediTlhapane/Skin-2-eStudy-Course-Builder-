# GROQ_API_KEY: Required for Groq Cloud AI inference (comma-separated keys supported for failover).
GROQ_API_KEY="MY_GROQ_API_KEY"
GROQ_API_KEY_2="MY_SECOND_GROQ_API_KEY"
GROQ_BACKUP_API_KEY="MY_BACKUP_GROQ_API_KEY"
GROQ_BACKUP_MODEL="llama-3.3-70b-versatile"

# APP_URL: The public URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CLIENT (safe for Vite browser bundle — never put service role keys in VITE_*)
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# SUPABASE SERVER (strictly server-side only — never expose in client code or logs)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# DISTRIBUTED RATE LIMITING (Uses Supabase PostgreSQL `public.consume_rate_limit` RPC in production)
# Requires SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY above and supabase/migrations/004_rate_limits.sql applied.
# Local development and automated tests fall back to MemoryRateLimitStore when not in production.
RATE_LIMIT_MAX_PER_MIN="60"

# BOUNDED AI CONCURRENCY (Active in-flight AI generation limits enforced server-side)
MAX_CONCURRENT_AI_PER_USER="2"
MAX_CONCURRENT_AI_PER_COMPANY="5"
